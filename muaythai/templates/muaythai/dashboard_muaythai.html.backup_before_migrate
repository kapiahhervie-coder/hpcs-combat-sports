<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HPCS - Digital Performance Profile (Muay Thai)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-dark: #060b13;
            --bg-panel: #0d1726;
            --neon-blue: #38bdf8;
            --neon-green: #4ade80;
            --border-panel: rgba(56, 189, 248, 0.25);
            --text-gray: #94a3b8;
        }
        body { background-color: var(--bg-dark); color: #ffffff; font-family: 'Segoe UI', Roboto, sans-serif; }

        .digital-profile-card {
            background: linear-gradient(180deg, #0b1a30 0%, #060d1a 100%);
            border: 2px solid var(--neon-blue);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.15);
        }
        .panel-main-title {
            font-size: 1.4rem; font-weight: 800; letter-spacing: 2px;
            color: #fff; text-transform: uppercase;
            background: linear-gradient(90deg, #0d2a4a, transparent);
            padding: 8px 16px; border-radius: 6px;
            border-left: 3px solid var(--neon-blue);
        }
        .sub-panel {
            background: rgba(13,23,38,0.6);
            border: 1px solid rgba(56,189,248,0.15);
            border-radius: 8px; padding: 16px; height: 100%;
        }
        .sub-panel-header {
            font-size: 0.75rem; font-weight: 700; letter-spacing: 1px;
            color: var(--text-gray); margin-bottom: 12px; text-transform: uppercase;
        }
        .avatar-frame {
            width: 85px; height: 105px;
            border: 2px solid var(--neon-blue);
            background: rgba(56,189,248,0.05);
            display: flex; align-items: center; justify-content: center;
            border-radius: 6px; flex-shrink: 0;
        }
        .id-number {
            font-family: 'Courier New', monospace;
            color: var(--neon-blue); font-weight: bold;
            font-size: 1.1rem; letter-spacing: 1px;
        }
        .load-bar { background: #1e293b; height: 8px; border-radius: 4px; margin-bottom: 10px; overflow: hidden; }
        .load-fill { background: var(--neon-blue); height: 100%; }
        .trophy-group i {
            color: #f59e0b; font-size: 1.8rem; margin-right: 6px;
            filter: drop-shadow(0 0 8px rgba(245,158,11,0.5));
        }

        /* Dropdown pilih atlet */
        .atlet-select {
            font-size: 11px; padding: 6px 10px;
            background: #0d1525; color: #e8f4ff;
            border: 1px solid rgba(56,189,248,0.3);
            border-radius: 8px; cursor: pointer; outline: none;
            min-width: 140px;
        }
        .atlet-select:focus { border-color: var(--neon-blue); }

        /* Tombol Report Card */
        .btn-report {
            font-size: 11px; padding: 7px 14px;
            background: linear-gradient(90deg, #b35c00, #f59e0b);
            color: #fff; border-radius: 8px; text-decoration: none;
            font-weight: 700; display: inline-flex; align-items: center; gap: 6px;
            border: none; cursor: pointer; white-space: nowrap;
            box-shadow: 0 4px 12px rgba(245,158,11,0.25);
            transition: opacity 0.2s;
        }
        .btn-report:hover { opacity: 0.85; color: #fff; }

        /* Level cards */
        .level-menu-title {
            margin-top: 36px; font-weight: 700;
            color: var(--neon-blue); text-transform: uppercase;
            font-size: 1rem; letter-spacing: 1px;
        }
        .level-grid-card {
            background: var(--bg-panel);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px; padding: 20px;
            transition: all 0.3s ease; height: 100%;
            display: flex; flex-direction: column; justify-content: space-between;
        }
        
.level-card-l1 { border-left: 3px solid #38bdf8; }
.level-card-l1 .level-huge-num, .level-card-l1 h5 { color: #38bdf8; }
.level-card-l1:hover { border-color: #38bdf8 !important; box-shadow: 0 8px 20px rgba(56,189,248,0.2) !important; }

.level-card-l2 { border-left: 3px solid #10b981; }
.level-card-l2 .level-huge-num, .level-card-l2 h5 { color: #10b981; }
.level-card-l2:hover { border-color: #10b981 !important; box-shadow: 0 8px 20px rgba(16,185,129,0.2) !important; }

.level-card-l3 { border-left: 3px solid #f59e0b; }
.level-card-l3 .level-huge-num, .level-card-l3 h5 { color: #f59e0b; }
.level-card-l3:hover { border-color: #f59e0b !important; box-shadow: 0 8px 20px rgba(245,158,11,0.2) !important; }

.level-card-l4 { border-left: 3px solid #e879f9; }
.level-card-l4 .level-huge-num, .level-card-l4 h5 { color: #e879f9; }
.level-card-l4:hover { border-color: #e879f9 !important; box-shadow: 0 8px 20px rgba(232,121,249,0.2) !important; }
        .level-grid-card:hover {
            border-color: var(--neon-blue);
            box-shadow: 0 8px 20px rgba(56,189,248,0.2);
            transform: translateY(-4px);
        }
        .level-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .level-tag {
            font-size: 0.75rem; background: rgba(56,189,248,0.1);
            color: var(--neon-blue); padding: 3px 10px;
            border-radius: 12px; font-weight: 600;
        }

        /* Angka 01-04 dengan warna aksen transparan per level */
        .level-huge-num {
            font-size: 2.2rem; font-weight: 900;
            line-height: 1; opacity: 1;
            color: rgba(56,189,248,0.12);
        }
        .level-grid-card:nth-child(1) .level-huge-num { color: rgba(56,189,248,0.15); }
        .level-grid-card:nth-child(2) .level-huge-num { color: rgba(0,255,136,0.15); }
        .level-grid-card:nth-child(3) .level-huge-num { color: rgba(255,179,0,0.15); }
        .level-grid-card:nth-child(4) .level-huge-num { color: rgba(255,107,157,0.15); }

        /* Deskripsi level - line-height konsisten */
        .level-grid-card p.text-secondary {
            line-height: 1.55;
            font-size: 0.82rem;
            min-height: 38px;
        }

        /* Tombol audit - konsisten semua level pakai border neon-blue */
        .btn-action-audit {
            background: transparent;
            border: 1px solid rgba(56,189,248,0.35);
            color: rgba(56,189,248,0.85);
            font-weight: 600; border-radius: 6px;
            transition: all 0.2s; font-size: 0.85rem;
        }
        .btn-action-audit:hover,
        .level-grid-card:hover .btn-action-audit {
            background: var(--neon-blue);
            border-color: var(--neon-blue);
            color: var(--bg-dark);
            box-shadow: 0 4px 12px rgba(56,189,248,0.3);
        }
    </style>
</head>
<body>
<div class="container py-4" style="padding-top:2.5rem!important;">

    <!-- -- TOP NAV -- -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-0">
                <span style="color:#00d2ff;font-weight:900;letter-spacing:2px;font-size:1.2em;">HPCS</span>
                <span style="color:#e8f4ff;font-weight:400;letter-spacing:1px;font-size:0.85em;"> MUAY THAI PANEL</span>
            </h5>
            <small class="text-secondary">Pelatih Kepala: <strong>Coach Fanny H. Kapiah, S.Pd</strong></small>
        </div>
        <a href="{% url 'muaythai:daftar_atlet' %}" class="btn btn-sm btn-outline-info">
            <i class="fa-solid fa-users me-2"></i>Daftar Atlet Muay Thai
        </a>
    </div>

    <!-- -- DIGITAL PERFORMANCE PROFILE -- -->
    <div class="digital-profile-card">

        <!-- Header: Judul + Pilih Atlet + Tombol Report -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="panel-main-title">Digital Performance Profile</div>
            <div class="d-flex align-items-center gap-2">

                <!-- Dropdown: ganti atlet di halaman ini (bukan buka tab baru) -->
                <select id="selAtlet" class="atlet-select"
                        onchange="gantiAtlet(this.value)">
                    <option value="">Pilih Atlet...</option>
                    {% for a in daftar_atlet %}
                    <option value="{{ a.pk }}"
                        {% if a.pk == atlet.pk %}selected{% endif %}>
                        {{ a.nama_atlet }}
                    </option>
                    {% endfor %}
                </select>

                <!-- Tombol Report Card - buka report atlet yang sedang tampil -->
                {% if atlet %}
                <a href="{% url 'muaythai:report_card' atlet.pk %}"
                   target="_blank" class="btn-report">
                    Report Card
                </a>
                {% else %}
                <span class="btn-report" style="opacity:0.4;cursor:not-allowed;">
                    Report Card
                </span>
                {% endif %}
            </div>
        </div>

        <!-- Sub-panels -->
        <div class="row g-3">

            <!-- ATHLETE ID -->
            <div class="col-md-4">
                <div class="sub-panel d-flex align-items-center gap-3">
                    <div class="avatar-frame">
                        <i class="fa-solid fa-user-ninja text-secondary fs-1"></i>
                    </div>
                    <div>
                        <div class="sub-panel-header">Athlete ID</div>
                        <h5 class="fw-bold mb-1 text-white" id="namaAtlet">
                            {{ atlet.nama_atlet|default:"-" }}
                        </h5>
                        <div class="id-number mb-1">
                            INA-{{ atlet.id|stringformat:"04d" }}
                        </div>
                        <small class="text-secondary">
                            BB: {{ atlet.kelas_berat|default:"-" }} kg
                        </small>
                    </div>
                </div>
            </div>

            <!-- PERFORMA PROGRESSION -->
            <div class="col-md-4">
                <div class="sub-panel">
                    <div class="sub-panel-header">Performa Progression</div>
                    <div style="height:100px;position:relative">
                        <canvas id="canvasProgression"></canvas>
                    </div>
                </div>
            </div>

            <!-- TRAINING LOAD & ACHIEVEMENT -->
            <div class="col-md-4">
                <div class="sub-panel">
                    <div class="row h-100 align-items-center">
                        <div class="col-7 border-end border-secondary border-opacity-25">
                            <div class="sub-panel-header">Training Load</div>
                            <div class="d-flex align-items-center gap-2">
                                <div style="font-size:1.6rem;font-weight:900;color:#fff;min-width:44px">
                                    {{ training_load|default:0 }}%
                                </div>
                                <div class="flex-grow-1">
                                    <div class="load-bar">
                                        <div class="load-fill" style="width:{{ training_load|default:0 }}%"></div>
                                    </div>
                                    <div class="load-bar">
                                        <div class="load-fill" style="width:60%;background:#4ade80"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-5 ps-3">
                            <div class="sub-panel-header">Achievement</div>
                            <div class="trophy-group d-flex">
                                <i class="fa-solid fa-trophy"></i>
                                <i class="fa-solid fa-trophy"></i>
                                <i class="fa-solid fa-trophy"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- -- MODUL EVALUASI LEVEL -- -->
    <div class="level-menu-title mt-4">
        <i class="fa-solid fa-network-wired me-2"></i>Modul Evaluasi Tingkat Performa
    </div>

    <div class="row g-3 mt-1">

        <!-- LEVEL 1 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="level-grid-card level-card-l1">
                <div>
                    <div class="level-top-row">
                        <span class="level-tag">Fondasi Gerak</span>
                        <div class="level-huge-num">01</div>
                    </div>
                    <h5 class="fw-bold mb-1">LEVEL 1</h5>
                    <p class="text-secondary small mb-0">Correction, Mobility, Stability &amp; Anatomi Sendi.</p>
                </div>
                <a href="{% url 'muaythai:l1_correction' %}?atlet_id={{ atlet.id }}"
                   class="btn btn-action-audit w-100 mt-3 py-2">
                   Audit Level 1 - Correction
                </a>
            </div>
        </div>

        <!-- LEVEL 2 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="level-grid-card level-card-l2">
                <div>
                    <div class="level-top-row">
                        <span class="level-tag">Kekuatan Otot</span>
                        <div class="level-huge-num">02</div>
                    </div>
                    <h5 class="fw-bold mb-1">LEVEL 2</h5>
                    <p class="text-secondary small mb-0">Maximum Strength &amp; Pengkondisian Dinding Core.</p>
                </div>
                <a href="{% url 'muaythai:l2_strength' %}"
                   class="btn btn-action-audit w-100 mt-3 py-2">Audit Level 2</a>
            </div>
        </div>

        <!-- LEVEL 3 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="level-grid-card level-card-l3">
                <div>
                    <div class="level-top-row">
                        <span class="level-tag">Daya Ledak</span>
                        <div class="level-huge-num">03</div>
                    </div>
                    <h5 class="fw-bold mb-1">LEVEL 3</h5>
                    <p class="text-secondary small mb-0">Power &amp; RFD (Kecepatan Transfer Energi Pukulan/Tendangan).</p>
                </div>
                <a href="{% url 'muaythai:l3_power' %}"
                   class="btn btn-action-audit w-100 mt-3 py-2">Audit Level 3</a>
            </div>
        </div>

        <!-- LEVEL 4 -->
        <div class="col-12 col-md-6 col-lg-3">
            <div class="level-grid-card level-card-l4">
                <div>
                    <div class="level-top-row">
                        <span class="level-tag">Spesifik Ring</span>
                        <div class="level-huge-num">04</div>
                    </div>
                    <h5 class="fw-bold mb-1">LEVEL 4</h5>
                    <p class="text-secondary small mb-0">Reactive Speed, Agility, &amp; Metabolic Yo-Yo Test.</p>
                </div>
                <a href="{% url 'muaythai:l4_speed_agility' %}"
                   class="btn btn-action-audit w-100 mt-3 py-2"
                   >Audit Level 4</a>
            </div>
        </div>

    </div>
</div>

<!-- -- SCRIPT -- -->
<script>
// Ganti atlet: reload halaman dengan atlet_id baru
function gantiAtlet(atletId) {
    if (!atletId) return;
    window.location.href = '{% url "muaythai:dashboard" %}?atlet_id=' + atletId;
}

// Chart progression dengan gradient fill + placeholder
const ctxProgress = document.getElementById('canvasProgression').getContext('2d');
const scoreData = {{ score_data|safe }};
const scoreLabels = {{ score_labels|safe }};

// Cek apakah data cukup (minimal 2 titik dengan nilai > 0)
const validData = scoreData.filter(v => v > 0);

if (validData.length < 2) {
    // Tampilkan placeholder text jika data kurang
    ctxProgress.canvas.style.opacity = '0.3';
    ctxProgress.font = 'bold 11px sans-serif';
    ctxProgress.fillStyle = '#38bdf8';
    ctxProgress.textAlign = 'center';
    ctxProgress.textBaseline = 'middle';
    ctxProgress.fillText(
        validData.length === 0
            ? 'Belum ada data audit'
            : 'Data tren muncul setelah minimal 2x audit',
        ctxProgress.canvas.width / 2,
        ctxProgress.canvas.height / 2
    );
    ctxProgress.font = '10px sans-serif';
    ctxProgress.fillStyle = '#445566';
    ctxProgress.fillText(
        'Lakukan audit L1-L4 untuk melihat perkembangan',
        ctxProgress.canvas.width / 2,
        ctxProgress.canvas.height / 2 + 20
    );
} else {
    // Gradient fill
    const gradientFill = ctxProgress.createLinearGradient(0, 0, 0, ctxProgress.canvas.height);
    gradientFill.addColorStop(0, 'rgba(56,189,248,0.3)');
    gradientFill.addColorStop(1, 'rgba(56,189,248,0.0)');

    new Chart(ctxProgress, {
        type: 'line',
        data: {
            labels: scoreLabels,
            datasets: [{
                label: 'Total Skor',
                data: scoreData,
                borderColor: '#38bdf8',
                borderWidth: 2.5,
                pointBackgroundColor: '#00e5ff',
                pointBorderColor: '#060f1e',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
                fill: true,
                backgroundColor: gradientFill,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 1000, easing: 'easeInOutQuart' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0d1525',
                    borderColor: 'rgba(56,189,248,0.3)',
                    borderWidth: 1,
                    titleColor: '#38bdf8',
                    bodyColor: '#e8f4ff',
                    padding: 10,
                    callbacks: {
                        label: ctx => ' Skor: ' + ctx.parsed.y.toFixed(1)
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: '#445566', font: { size: 9 } }
                },
                y: {
                    min: 0, max: 10,
                    grid: { color: 'rgba(255,255,255,0.04)' },
                    ticks: { color: '#445566', font: { size: 9 }, stepSize: 2 }
                }
            }
        }
    });
}
</script>

</body>
</html>



