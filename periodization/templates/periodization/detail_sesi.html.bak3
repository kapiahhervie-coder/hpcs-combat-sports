{% extends 'base.html' %}
{% load static %}
{% block title %}HPCS - {{ sesi.nama_sesi }}{% endblock %}
{% block page_title %}Detail Sesi Latihan{% endblock %}

{% block content %}
<div style="margin-bottom:8px; font-size:12px; color:#9ca3af;">
    <a href="{% url 'periodization:daftar_program' %}" style="color:#9ca3af; text-decoration:none;">Daftar Program</a>
    <span style="margin:0 4px;">/</span>
    <a href="{% url 'periodization:detail_program' sesi.micro_cycle.meso_cycle.macro_program.id %}" style="color:#9ca3af; text-decoration:none;">{{ sesi.micro_cycle.meso_cycle.macro_program.nama_program }}</a>
    <span style="margin:0 4px;">/</span>
    <a href="{% url 'periodization:detail_meso' sesi.micro_cycle.meso_cycle.id %}" style="color:#9ca3af; text-decoration:none;">{{ sesi.micro_cycle.meso_cycle.get_nama_fase_display }}</a>
    <span style="margin:0 4px;">/</span>
    <a href="{% url 'periodization:detail_micro' sesi.micro_cycle.id %}" style="color:#9ca3af; text-decoration:none;">Minggu {{ sesi.micro_cycle.minggu_ke }}</a>
    <span style="margin:0 4px;">/</span>
    <span style="color:#374151; font-weight:600;">{{ nama_hari }}</span>
</div>

<div style="margin-bottom:14px;">
    <h2 style="margin:8px 0 4px;">{{ sesi.nama_sesi|default:"Sesi Latihan" }}</h2>
    <p style="color:#6b7280; margin:0;">
        {{ sesi.tanggal|date:"l, d M Y" }} &middot; <strong>{{ sesi.get_waktu_sesi_display }}</strong> &middot; {{ sesi.get_pilar_fokus_display }}
        &middot; {{ sesi.durasi_menit }} menit &middot; Intensitas {{ sesi.intensitas }}/10
    </p>
</div>

<div style="display:flex; gap:10px; margin-bottom:20px; flex-wrap:wrap;">
    {% for h in hari_list %}
        <div style="display:flex; flex-direction:column; gap:4px;">
            <span style="font-size:10px; color:#9ca3af; text-transform:uppercase; font-weight:600;">{{ h.nama_hari }}</span>
            <div style="display:flex; gap:4px; flex-wrap:wrap;">
                {% if h.sesi_list %}
                    {% for s in h.sesi_list %}
                        {% if s.id == sesi.id %}
                            <span style="background:#e63946; color:#fff; padding:5px 10px; border-radius:8px; font-size:11px; font-weight:600;">{{ s.get_waktu_sesi_display }}</span>
                        {% else %}
                            <a href="{% url 'periodization:detail_sesi' s.id %}" style="background:#f3f4f6; color:#374151; padding:5px 10px; border-radius:8px; font-size:11px; font-weight:600; text-decoration:none;">{{ s.get_waktu_sesi_display }}</a>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <span style="background:#f9fafb; color:#d1d5db; padding:5px 10px; border-radius:8px; font-size:11px; font-weight:600;">-</span>
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>

<!-- Program latihan yang sudah tersimpan, dikelompokkan per kategori -->
<div style="background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; margin-bottom:20px; overflow-x:auto;">
    <h3 style="margin-top:0; margin-bottom:14px;">Program Latihan</h3>

    {% if kategori_groups %}
        <table style="width:100%; border-collapse: collapse; min-width:900px;">
            <thead>
                <tr style="text-align:left; border-bottom: 2px solid #e5e7eb;">
                    <th style="padding: 8px; width:36px;">#</th>
                    <th style="padding: 8px;">Program</th>
                    <th style="padding: 8px;">Rep</th>
                    <th style="padding: 8px;">Set</th>
                    <th style="padding: 8px;">Waktu</th>
                    <th style="padding: 8px;">Istirahat</th>
                    <th style="padding: 8px;">Beban</th>
                    <th style="padding: 8px;">Keterangan</th>
                    <th style="padding: 8px;"></th>
                </tr>
            </thead>
            <tbody>
                {% for grup in kategori_groups %}
                <tr>
                    <td colspan="9" style="background:#111826; color:#fff; padding:8px 10px; font-weight:700; font-size:12px; text-transform:uppercase; letter-spacing:.5px;">
                        {{ grup.label }}
                    </td>
                </tr>
                {% for item in grup.items %}
                <tr style="border-bottom: 1px solid #f3f4f6;">
                    <td style="padding: 8px; color:#9ca3af;">{{ forloop.counter }}</td>
                    <td style="padding: 8px; font-weight:600;">
                        {% if item.link_video %}
                            <a href="{{ item.link_video }}" target="_blank" rel="noopener" style="color:#2563eb; text-decoration:underline;">{{ item.nama_latihan }}</a>
                        {% else %}
                            {{ item.nama_latihan }}
                        {% endif %}
                    </td>
                    <td style="padding: 8px;">{{ item.jumlah_rep|default:"-" }}</td>
                    <td style="padding: 8px;">{{ item.jumlah_set }}</td>
                    <td style="padding: 8px;">{{ item.waktu|default:"-" }}</td>
                    <td style="padding: 8px;">{{ item.durasi_istirahat_detik }} detik</td>
                    <td style="padding: 8px;">{{ item.beban_intensitas|default:"-" }}</td>
                    <td style="padding: 8px; color:#6b7280; font-size:13px;">{{ item.catatan|default:"-" }}</td>
                    <td style="padding: 8px; text-align:right;">
                        <form method="post" action="{% url 'periodization:hapus_item' item.id %}" style="margin:0; display:inline;">
                            {% csrf_token %}
                            <button type="submit" onclick="return confirm('Hapus exercise ini?');"
                                    style="background:none; border:none; color:#991b1b; cursor:pointer; font-size:12px;">Hapus</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p style="color:#9ca3af; font-size:13px;">Belum ada exercise di sesi ini. Isi tabel di bawah buat mulai.</p>
    {% endif %}
</div>

<!-- Tambah exercise -- Excel-style, isi banyak baris sekaligus -->
<div style="background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:20px; overflow-x:auto;">
    <h3 style="margin-top:0; margin-bottom:14px;">Tambah Exercise</h3>
    <p style="color:#6b7280; font-size:12px; margin-top:-8px; margin-bottom:14px;">
        Isi langsung kayak tabel Excel. Baris kosong (nama latihan kosong) otomatis dilewati. Klik "+ Tambah Baris" kalau butuh baris lebih banyak.
    </p>

    <form method="post" action="{% url 'periodization:tambah_item' sesi.id %}">
        {% csrf_token %}
        <table style="width:100%; border-collapse: collapse; min-width:1100px;">
            <thead>
                <tr style="text-align:left; border-bottom: 2px solid #e5e7eb;">
                    <th style="padding: 6px; width:130px;">Kategori</th>
                    <th style="padding: 6px; min-width:160px;">Nama Latihan</th>
                    <th style="padding: 6px; width:80px;">Rep</th>
                    <th style="padding: 6px; width:70px;">Set</th>
                    <th style="padding: 6px; width:90px;">Waktu</th>
                    <th style="padding: 6px; width:90px;">Istirahat (detik)</th>
                    <th style="padding: 6px; width:110px;">Beban</th>
                    <th style="padding: 6px; min-width:140px;">Keterangan</th>
                    <th style="padding: 6px; min-width:160px;">Link Video (opsional)</th>
                </tr>
            </thead>
            <tbody id="exercise-rows-body">
                {% for i in "123" %}
                <tr>
                    <td style="padding: 4px;">
                        <select name="kategori[]" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;">
                            {% for val, label in kategori_choices %}
                                <option value="{{ val }}" {% if val == 'INTI' %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </td>
                    <td style="padding: 4px;"><input type="text" name="nama_latihan[]" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="text" name="jumlah_rep[]" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="number" min="1" name="jumlah_set[]" value="3" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="text" name="waktu[]" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="number" min="0" name="durasi_istirahat_detik[]" value="60" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="text" name="beban_intensitas[]" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="text" name="catatan[]" style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                    <td style="padding: 4px;"><input type="url" name="link_video[]" placeholder="https://..." style="width:100%; padding:6px; border:1px solid #d1d5db; border-radius:6px; font-size:12px;"></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px;">
            <button type="button" onclick="tambahBarisExercise()"
                    style="background:#f3f4f6; border:1px solid #d1d5db; border-radius:8px; padding:8px 14px; font-size:13px; cursor:pointer;">
                + Tambah Baris
            </button>
            <button type="submit"
                    style="background:#e63946; color:#fff; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:600; cursor:pointer;">
                Simpan Semua Exercise
            </button>
        </div>
    </form>
</div>

{% endblock %}

{% block extra_js %}
<script>
// Default istirahat (detik) berdasarkan pilar sesi. Ubah angka di sini sesuai protokol pelatih.
const PILAR_SESI = '{{ sesi.pilar_fokus }}';
const ISTIRAHAT_PILAR = {
    L1: 30, L2: 90, L3: 180, L4: 120,
    TEKNIK: 60, RECOVERY: 30, KOMPETISI: 60, REST: 60
};
const ISTIRAHAT_KATEGORI = { PEMANASAN: 30, PENDINGINAN: 30 };

function istirahatDefault(kategori) {
    if (ISTIRAHAT_KATEGORI[kategori] !== undefined) return ISTIRAHAT_KATEGORI[kategori];
    return ISTIRAHAT_PILAR[PILAR_SESI] !== undefined ? ISTIRAHAT_PILAR[PILAR_SESI] : 60;
}

function pasangIstirahatOtomatis(row) {
    const sel = row.querySelector('select[name="kategori[]"]');
    const inp = row.querySelector('input[name="durasi_istirahat_detik[]"]');
    if (!sel || !inp) return;
    delete inp.dataset.manual;
    inp.value = istirahatDefault(sel.value);
    sel.addEventListener('change', function() {
        if (!inp.dataset.manual) inp.value = istirahatDefault(sel.value);
    });
    inp.addEventListener('input', function() { inp.dataset.manual = '1'; });
}

function tambahBarisExercise() {
    const tbody = document.getElementById('exercise-rows-body');
    const rows = tbody.querySelectorAll('tr');
    const lastRow = rows[rows.length - 1];
    const newRow = lastRow.cloneNode(true);
    newRow.querySelectorAll('input').forEach(function(el) {
        if (el.name.indexOf('jumlah_set') !== -1) { el.value = '3'; }
        else if (el.name.indexOf('istirahat') === -1) { el.value = ''; }
    });
    newRow.querySelectorAll('select').forEach(function(el) { el.value = 'INTI'; });
    tbody.appendChild(newRow);
    pasangIstirahatOtomatis(newRow);
}

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('#exercise-rows-body tr').forEach(pasangIstirahatOtomatis);
});
</script>
{% endblock %}