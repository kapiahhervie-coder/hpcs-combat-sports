{% extends "base_basketball.html" %}
{% load static %}
{% block extra_css %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
:root{
  --bg:#07080d;--surface:#0f1018;--card:#13151f;--card2:#181b26;
  --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);
  --text:#e4e8f4;--text2:#8892a8;--text3:#454e66;
  --cyan:#f97316;--gold:#f5a623;--green:#2ecc71;--red:#e74c3c;--blue:#3498db;
}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;min-height:100vh;}
.mono{font-family:'JetBrains Mono',monospace}
.bebas{font-family:'Bebas Neue',sans-serif}
.x-small{font-size:0.72rem}
.topbar{background:rgba(7,8,13,0.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--border2);padding:0 28px;height:54px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;width:100%;}
.topbar-brand{display:flex;align-items:center;gap:10px}
.brand-mark{width:32px;height:32px;border-radius:7px;background:linear-gradient(135deg,var(--cyan),#ea6c0a);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:16px;color:#000;}
.brand-title{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:3px;color:var(--text)}
.brand-sub{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--text3);letter-spacing:1.5px}
.btn-dash{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;font-weight:700;letter-spacing:1.5px;
    padding:8px 18px;border-radius:8px;
    background:linear-gradient(135deg,rgba(249,115,22,0.15),rgba(249,115,22,0.05));
    border:1.5px solid var(--cyan);
    color:var(--cyan);text-decoration:none;
    transition:.2s;display:inline-flex;align-items:center;gap:7px;
    box-shadow:0 0 12px rgba(249,115,22,0.15);
}
.btn-dash:hover{
    background:linear-gradient(135deg,rgba(249,115,22,0.3),rgba(249,115,22,0.1));
    color:#fff;box-shadow:0 0 20px rgba(249,115,22,0.3);
    transform:translateY(-1px);
}
.main{padding:20px 28px;max-width:1500px;margin:0 auto}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(28px,4vw,42px);letter-spacing:3px;color:var(--cyan);line-height:1;}
.page-sub{font-size:11px;color:var(--text3);margin-top:3px;font-family:'JetBrains Mono',monospace;letter-spacing:1px}
.filter-bar{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:10px 0}
.ftab{padding:4px 14px;border-radius:20px;font-size:10px;font-weight:600;text-transform:uppercase;text-decoration:none;letter-spacing:1px;border:1px solid var(--border2);color:var(--text3);transition:.2s;}
.ftab-all{border-color:#fff;color:#fff;background:rgba(255,255,255,0.07)}
.ftab-elite{border-color:var(--green);color:var(--green);background:rgba(46,204,113,0.08)}
.ftab-youth{border-color:var(--blue);color:var(--blue);background:rgba(52,152,219,0.08)}
.ftab-junior{border-color:var(--gold);color:var(--gold);background:rgba(245,166,35,0.08)}
.ftab-senior{border-color:var(--red);color:var(--red);background:rgba(231,76,60,0.08)}
.card-x{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:20px;height:100%;}
.card-title{font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:600;letter-spacing:2px;color:var(--text3);text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:6px;border-left:3px solid var(--cyan);padding-left:10px;}
.form-control,.form-select{background:#1a1c28!important;border:1px solid #2a2d3e;color:var(--text)!important;border-radius:8px;font-size:13px;transition:border-color .2s;}
.form-control:focus,.form-select:focus{background:#1f2133!important;border-color:var(--cyan)!important;box-shadow:0 0 0 2px rgba(249,115,22,0.12)!important;color:var(--text)!important;}
.form-control[readonly]{background:#111320!important;border-color:#1e2030;color:var(--text3)!important;cursor:default}
.form-select option{background:#1a1c28!important;color:var(--text)!important}
label{font-size:11px;color:var(--text2);margin-bottom:4px;display:block;font-family:'JetBrains Mono',monospace;letter-spacing:.5px}
label.cyan{color:var(--cyan)} label.gold{color:var(--gold)}
#radarChart{max-height:300px}
.score-big{font-family:'Bebas Neue',sans-serif;font-size:80px;line-height:1;color:var(--cyan);transition:color .4s;}
.predikat-pill{display:inline-block;padding:6px 22px;border-radius:30px;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;border:2px solid;transition:all .3s;}
.pred-ELITE{border-color:var(--green);color:var(--green);background:rgba(46,204,113,0.1)}
.pred-READY{border-color:var(--cyan);color:var(--cyan);background:rgba(249,115,22,0.1)}
.pred-DEVELOPING{border-color:var(--gold);color:var(--gold);background:rgba(245,166,35,0.1)}
.pred-NOVICE{border-color:var(--red);color:var(--red);background:rgba(231,76,60,0.1)}
.reko-item{display:flex;gap:8px;align-items:flex-start;padding:7px 10px;border-radius:8px;margin-bottom:5px;background:rgba(249,115,22,0.05);border:1px solid rgba(249,115,22,0.12);font-size:11px;line-height:1.55;}
.reko-icon{font-size:13px;flex-shrink:0;margin-top:1px}
/* Rubrik */
.rubrik-toggle{display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--cyan);cursor:pointer;padding:4px 10px;border-radius:6px;border:1px solid rgba(249,115,22,0.2);transition:.2s;margin-top:10px;}
.rubrik-panel{margin-top:12px;border:1px solid var(--border2);border-radius:12px;overflow:hidden;}
.rubrik-header{background:linear-gradient(90deg,#3d1a00,#f97316);color:#000;font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;display:grid;grid-template-columns:200px 1fr 1fr 1fr;}
.rubrik-header div,.rubrik-row div{padding:10px 12px}
.rubrik-tabs{display:flex;gap:4px;padding:8px 10px;background:var(--card2);border-bottom:1px solid var(--border)}
.rtab{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:1px;padding:3px 10px;border-radius:12px;border:1px solid var(--border2);color:var(--text3);cursor:pointer;transition:.2s;}
.rtab.active,.rtab:hover{color:var(--text);background:rgba(255,255,255,0.06)}
.rubrik-row{display:grid;grid-template-columns:200px 1fr 1fr 1fr;border-top:1px solid var(--border);}
.rubrik-row:hover{background:rgba(255,255,255,0.02)}
.aspek-cell{background:var(--card2);border-right:2px solid var(--cyan)}
.aspek-name{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--cyan);display:block;margin-bottom:2px}
.aspek-test{font-size:10px;color:var(--text3)}
.aspek-link{font-size:10px;color:var(--blue);text-decoration:none;display:inline-flex;align-items:center;gap:3px;margin-top:3px}
.val-cell{padding:10px 12px}
.score-chip{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:9px;padding:2px 7px;border-radius:4px;border-left:3px solid;margin:1px 0;line-height:1.5;width:100%;}
.chip-green{border-left-color:var(--green);background:rgba(46,204,113,0.08);color:#9be8b5}
.chip-blue{border-left-color:var(--blue);background:rgba(52,152,219,0.08);color:#90c8f0}
.chip-yellow{border-left-color:var(--gold);background:rgba(245,166,35,0.08);color:#f5d08a}
.table-dark{--bs-table-bg:transparent;--bs-table-hover-bg:rgba(255,255,255,0.03)}
.table thead th{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);font-weight:400;border-bottom:1px solid var(--border2)!important;padding:10px 12px;}
.table td{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.04)!important;vertical-align:middle}
.modal-content{background:var(--card);border:1px solid var(--border2)}
.toast-hpcs{position:fixed;top:18px;right:18px;z-index:9999;font-family:'JetBrains Mono',monospace;font-size:11px;padding:10px 18px;border-radius:8px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,0.4);transition:opacity .4s;}
.no-print{display:block}
@media print{
  body{background:#fff!important;color:#000!important}
  .card-x{background:#fff!important;border-color:#eee!important}
  .score-big{color:#c2570c!important}
  .page-title{color:#c2570c!important}
}
.auto-score-row{display:flex;align-items:center;gap:8px;margin:2px 0 6px;}
.auto-score-label{font-size:0.65rem;color:var(--text3);text-transform:uppercase;letter-spacing:1px;}
.auto-score-badge{
  display:inline-block;font-family:'Bebas Neue',sans-serif;font-size:1rem;font-weight:700;
  color:var(--cyan);background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.3);
  border-radius:6px;padding:2px 10px;margin-left:auto;min-width:44px;text-align:center;
}
.auto-score-badge.as-elite{color:var(--green);background:rgba(46,204,113,0.1);border-color:rgba(46,204,113,0.3);}
.auto-score-badge.as-ready{color:var(--cyan);background:rgba(249,115,22,0.1);border-color:rgba(249,115,22,0.3);}
.auto-score-badge.as-dev{color:var(--gold);background:rgba(255,179,0,0.1);border-color:rgba(255,179,0,0.3);}
.auto-score-badge.as-novice{color:var(--red);background:rgba(255,107,107,0.1);border-color:rgba(255,107,107,0.3);}

.btn-hdr{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1px;padding:5px 12px;border-radius:6px;border:1px solid;text-decoration:none;cursor:pointer;display:inline-flex;align-items:center}
.btn-hdr:hover{filter:brightness(1.25);color:inherit}
.btn-save{background:rgba(249,115,22,0.15);border:1px solid var(--cyan);color:var(--cyan);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:1px}
.btn-save:hover{background:rgba(249,115,22,0.3);color:#fff}
.penalti-flag{margin:-4px 0 10px;font-size:9.5px;font-family:'JetBrains Mono',monospace;color:var(--red);background:rgba(231,76,60,0.08);border:1px solid rgba(231,76,60,0.25);border-radius:6px;padding:5px 8px}
.narasi-box{background:rgba(249,115,22,0.05);border:1px solid rgba(249,115,22,0.2);border-radius:10px;padding:12px 14px;font-size:11px;line-height:1.7;color:var(--text2);text-align:left;max-height:320px;overflow-y:auto}
</style>
<style>
.l1doc{font-size:11px;color:var(--text2);line-height:1.55;padding:14px 16px}
.l1doc h3{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:900;color:#f97316;text-transform:uppercase;
  letter-spacing:1.5px;border-left:3px solid #f97316;padding:5px 0 5px 10px;margin:18px 0 8px;background:rgba(249,115,22,0.06)}
.l1doc h3:first-child{margin-top:0}
.l1doc table{width:100%;border-collapse:collapse;margin-bottom:10px;font-size:10.5px}
.l1doc th,.l1doc td{border:1px solid var(--border2);padding:6px 8px;text-align:left;vertical-align:middle}
.l1doc th{background:#2a1400;color:#f97316;font-weight:700;font-size:9.5px;text-transform:uppercase;letter-spacing:.5px}
.l1doc td.kurang{background:rgba(255,107,107,0.06);color:#e89090}
.l1doc td.cukup{background:rgba(255,179,0,0.06);color:#e8c870}
.l1doc td.baik{background:rgba(0,255,136,0.06);color:#a0e4bc}
.l1doc .catatan-box{background:rgba(255,179,0,0.06);border:1px solid rgba(255,179,0,0.25);border-radius:8px;padding:8px 12px;margin:6px 0 14px;font-size:10.5px;color:#e8c870}
.l1doc .sop-test{background:rgba(255,255,255,0.02);border:1px solid var(--border2);border-radius:10px;padding:12px 14px;margin-bottom:10px}
.l1doc .sop-test .judul{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--cyan);font-size:11px;margin-bottom:2px}
.l1doc .sop-test .alt{font-size:9.5px;color:var(--text3);margin-bottom:6px;font-style:italic}
.l1doc .sop-test ol{margin:0;padding-left:18px}
.l1doc .sop-test li{margin-bottom:3px}
.l1doc .sop-tools{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 16px}
.l1doc .sop-tool-chip{font-family:'JetBrains Mono',monospace;font-size:9px;padding:3px 10px;border-radius:12px;border:1px solid var(--border2);color:var(--text3)}
.l1doc .anak-note{background:rgba(52,152,219,0.06);border:1px solid rgba(52,152,219,0.25);border-radius:10px;padding:12px 14px;margin-top:14px}
.l1doc .anak-note .judul{color:var(--blue);font-weight:700;font-size:10.5px;margin-bottom:6px}
.l1doc .anak-note ul{margin:0;padding-left:18px}
.l1doc .anak-note li{margin-bottom:4px}
</style>
{% endblock %}

{% block content %}
<div class="main">

  {% if messages %}{% for msg in messages %}
  <div class="alert alert-dismissible fade show no-print mono" style="background:rgba(249,115,22,.08);border:1px solid rgba(249,115,22,.35);color:var(--text);font-size:12px">{{ msg }}<button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button></div>
  {% endfor %}{% endif %}

  <!-- PAGE HEADER -->
  <h1 class="page-title">HPCS LEVEL 1 — CORE &amp; MOBILITY</h1>
  <div class="page-sub">Audit Fisik &amp; Mobilitas Basketball · Coach {{ request.user.get_full_name|default:request.user.username }}</div>
  <div class="filter-bar no-print">
    <span class="mono x-small" style="color:var(--text3)"><i class="bi bi-funnel-fill me-1"></i>FILTER:</span>
    <a href="?category=" class="ftab {% if not selected_category %}ftab-all{% endif %}">Semua</a>
    <a href="?category=elite" class="ftab {% if selected_category == 'elite' %}ftab-elite{% endif %}">Elite</a>
    <a href="?category=youth" class="ftab {% if selected_category == 'youth' %}ftab-youth{% endif %}">Youth</a>
    <a href="?category=junior" class="ftab {% if selected_category == 'junior' %}ftab-junior{% endif %}">Junior</a>
    <a href="?category=senior" class="ftab {% if selected_category == 'senior' %}ftab-senior{% endif %}">Senior</a>
    {% if selected_category %}<a href="?category=" class="x-small" style="color:var(--text3);text-decoration:none"><i class="bi bi-x-circle"></i> Reset</a>{% endif %}
  </div>
  <div class="d-flex align-items-center justify-content-between no-print" style="margin-top:10px;flex-wrap:wrap;gap:8px">
    <a class="rubrik-toggle" onclick="toggleRubrik()" id="btnRubrik" style="margin-top:0">
      <i class="bi bi-table"></i> RUBRIK STANDAR SKORING <i class="bi bi-chevron-down" id="rubrik-chevron"></i>
    </a>
    <div class="d-flex gap-2">
      <a href="{% url 'basketball:dashboard' %}" class="btn-hdr" style="background:rgba(255,255,255,0.05);border-color:var(--border2);color:var(--text2)"><i class="bi bi-house-fill me-1"></i>DASHBOARD</a>
      <a href="{% url 'basketball:l2_strength' %}" class="btn-hdr" style="background:rgba(96,165,250,0.12);border-color:#60a5fa;color:#60a5fa">L2 STRENGTH <i class="bi bi-arrow-right ms-1"></i></a>
      <button type="button" onclick="window.print()" class="btn-hdr" style="background:rgba(249,115,22,0.12);border-color:var(--cyan);color:var(--cyan)"><i class="bi bi-printer-fill me-1"></i>PRINT REPORT</button>
    </div>
  </div>

  <!-- RUBRIK + SOP (dirender dari JSON server → selalu sama dengan skor yang disimpan) -->
  <div class="rubrik-panel no-print" id="rubrikPanel" style="display:none">
    <div class="l1doc">
      <h3>📊 Rubrik Norma Penilaian &amp; Skoring (1–10)</h3>
      <div style="font-size:10px;color:var(--text3);margin-bottom:10px">Skor dihitung otomatis oleh sistem berdasarkan usia &amp; gender atlet — tabel ini untuk referensi pelatih. Ambang Ankle &amp; Stability identik dengan SOP Level 1 Boxing; Hip &amp; Shoulder adalah norma kerja Basketball.</div>
      <div id="rubrikTables"></div>
      <b style="font-size:10.5px;color:var(--text)">E. Postur &amp; Spine <span style="color:var(--text3);font-weight:400">(Skala Kualitatif — observasi pelatih)</span></b>
      <table>
        <thead><tr><th>Parameter</th><th>Kurang (1–4)</th><th>Cukup (5–7)</th><th>Baik/Ideal (8–10)</th></tr></thead>
        <tbody><tr><td><b>Posture Screening</b></td>
          <td class="kurang">Deviasi berat (forward head parah, hyper-kyphosis, atau bahu miring).</td>
          <td class="cukup">Deviasi ringan pada 1 segmen tubuh (mis. forward head ringan, bahu sedikit membulat).</td>
          <td class="baik">Alignment netral: kepala tegak, bahu sejajar, panggul simetris.</td></tr></tbody>
      </table>
      <div class="catatan-box">⚠️ <b>Penalti Asimetri (dihitung server):</b> Ankle — selisih kiri vs kanan &gt; 2 cm; Hip — selisih &gt; 10°. Skor pilar tersebut dikurangi <b>1 poin</b>. Basket adalah olahraga unilateral (cut, landing satu kaki), jadi sisi terlemah menentukan risiko cedera. Ankle &amp; Hip memakai sisi <b>terlemah</b>; Stability memakai rata-rata kiri–kanan.</div>
      <div class="catatan-box">📐 <b>Cara baca skor di bawah ambang "Kurang":</b> nilai di bawah batas minimum tidak otomatis 0, tapi proporsional: <code>skor = 1 + 3 × (nilai terukur ÷ batas bawah)</code>. Contoh: Ankle dewasa putra (batas 9 cm), hasil 6 cm → 1 + 3×(6/9) = <b>3.0/10</b>.</div>
      <div class="anak-note">
        <div class="judul">📌 Catatan Khusus Pelatih — Anak-Anak (6–11 Tahun)</div>
        <ul>
          <li><b>Gamifikasi:</b> Single Leg Stance → "berdiri seimbang seperti bangau". Hip flexion → "tarik lutut ke dada seperti melompat tali".</li>
          <li><b>Utamakan kualitas pola gerak</b> — amati kompensasi tubuh, jangan hanya mengejar angka. Norma anak bersifat kerja dan perlu validasi.</li>
        </ul>
      </div>

      <h3 style="margin-top:22px">📋 SOP — Prosedur Pelaksanaan Tes Lapangan</h3>
      <div class="sop-tools">
        <span class="sop-tool-chip">📏 Meteran/Pita ukur</span><span class="sop-tool-chip">📐 Goniometer/Clinometer HP</span>
        <span class="sop-tool-chip">⏱️ Stopwatch</span><span class="sop-tool-chip">🧘 Matras</span><span class="sop-tool-chip">📍 Line tape</span>
      </div>
      <div class="sop-test"><div class="judul">1. Ankle Mobility Test</div><div class="alt">Weight-Bearing Lunge Test (Knee-to-Wall)</div>
        <ol><li>Atlet menghadap dinding, jari kaki satu kaki menyentuh dinding.</li><li>Dorong lutut ke depan hingga menyentuh dinding; tumit wajib menempel lantai.</li><li>Mundurkan kaki bertahap sampai jarak terjauh yang masih lolos.</li><li>Ukur jarak jempol kaki ke dinding (cm) untuk kiri &amp; kanan. <i>Relevansi basket: cut, defensive slide, penyerapan landing.</i></li></ol></div>
      <div class="sop-test"><div class="judul">2. Hip Mobility Test</div><div class="alt">Hip Flexion ROM (goniometer)</div>
        <ol><li>Atlet telentang, tungkai sisi lawan lurus menempel matras.</li><li>Tekuk lutut sisi tes dan tarik paha ke dada maksimal tanpa punggung bawah terangkat.</li><li>Goniometer: poros di trokanter mayor, lengan diam sejajar batang tubuh, lengan gerak sejajar tulang paha.</li><li>Catat kiri &amp; kanan. <i>Relevansi: defensive stance rendah, squat/landing dalam.</i></li></ol></div>
      <div class="sop-test"><div class="judul">3. Shoulder Mobility Test</div><div class="alt">Shoulder Flexion ROM (goniometer)</div>
        <ol><li>Berdiri tegak atau telentang; lengan di sisi tubuh, telapak menghadap paha.</li><li>Angkat satu lengan ke depan-atas (bidang sagital), siku lurus, tulang rusuk tidak mengembang.</li><li>Goniometer: poros di sendi bahu, lengan diam sejajar batang tubuh, lengan gerak sejajar lengan atas.</li><li>Catat nilai terbaik (lengan tembak). <i>Relevansi: release point shooting, finger roll, blok.</i></li></ol></div>
      <div class="sop-test"><div class="judul">4. Stability Test</div><div class="alt">Single Leg Stance Test (SLST, mata tertutup)</div>
        <ol><li>Berdiri tegak, angkat satu kaki (lutut ±90°), tangan disilang di dada.</li><li>Mata tertutup → mulai stopwatch.</li><li>Stop jika kaki menyentuh lantai / goyang hebat / mata terbuka.</li><li>3 percobaan per kaki, catat terbaik Kiri &amp; Kanan. <i>Relevansi: stabilitas landing jump shot &amp; rebound.</i></li></ol></div>
      <div class="sop-test"><div class="judul">5. Posture &amp; Alignment Screening</div><div class="alt">Plumb Line Screening</div>
        <ol><li>Atlet berdiri rileks di depan plumb line yang difiksasi tetap.</li><li>Lateral: amati kesejajaran telinga → bahu → pinggul → lutut → maleolus.</li><li>Anterior &amp; posterior: amati simetri bahu, pinggul, dan kaki; pilih kategori Baik/Cukup/Kurang. <i>Relevansi: release point konsisten, field of vision saat dribble.</i></li></ol></div>
      <div style="font-size:9px;color:var(--text3);margin-top:6px;padding-top:8px;border-top:1px solid var(--border2)">Sumber: SOP &amp; Rubrik Asesmen HPCS Level 1 — Revisi 1 (Ankle &amp; Stability), disesuaikan untuk Basketball (Hip &amp; Shoulder = norma kerja).</div>
    </div>
  </div>

  <form id="form-audit" method="POST">
    {% csrf_token %}
    <div class="row g-3 mb-3 mt-1">

      <!-- Kolom 1: Identitas + Pilar -->
      <div class="col-lg-4">
        <div class="card-x">
          <div class="card-title"><i class="bi bi-person-fill"></i> Identitas Atlet</div>
          {% if atlet_list %}
          <div class="mb-3">
            <label>Pilih Atlet</label>
            <select id="select-atlet" class="form-select" onchange="onAtletChange(this)">
              <option value=""> Pilih Atlet </option>
              {% for atlet in atlet_list %}
              <option value="{{ atlet.id }}" {% if atlet.id == atlet_id_terpilih %}selected{% endif %}
                      data-nama="{{ atlet.nama_atlet }}" data-kategori="{{ atlet.kategori_umur }}" data-gender="{{ atlet.gender }}"
                      data-berat="{{ atlet.kelas_berat|stringformat:'g' }}" data-umur="{{ atlet.umur|default_if_none:'' }}" data-posisi="{{ atlet.posisi }}">
                {{ atlet.nama_atlet }}
              </option>
              {% endfor %}
            </select>
            <div class="x-small mono mt-1" style="color:var(--text3)">
              {% if selected_category %}Kategori: <strong style="color:var(--cyan)">{{ selected_category|title }}</strong> <a href="?category=" style="color:var(--text3)">Reset</a>
              {% else %}{{ atlet_list|length }} atlet ditemukan.{% endif %}
            </div>
          </div>
          {% else %}
          <div class="alert alert-warning py-2 small">Tidak ada atlet{% if selected_category %} kategori <strong>{{ selected_category|title }}</strong>{% endif %}.</div>
          {% endif %}
          <input type="hidden" name="atlet_id" id="id_atlet_hidden">
          <input type="hidden" name="atlet_name" id="atlet_name_hidden">
          <input type="hidden" name="kelas_berat" id="kelas_berat_hidden">
          <input type="hidden" name="kategori_usia" id="kategori_usia_hidden" value="ELITE">
          <input type="hidden" name="gender" id="gender_hidden" value="Putra">
          <input type="hidden" name="posisi" id="posisi_hidden">

          <div class="card-title mt-2"><i class="bi bi-bar-chart-fill"></i> Pilar Analysis</div>
          <div class="row g-2">
            <div class="col-12">
              <label class="cyan">Kategori Usia (SOP)</label>
              <select id="usia_kat_sop" name="usia_kat_sop" class="form-control" onchange="recalcAll();">
                <option value="7">Anak-anak (6-8 thn)</option>
                <option value="10">Anak-anak (9-11 thn)</option>
                <option value="15">Remaja (12-17 thn)</option>
                <option value="25" selected>Dewasa (18-35 thn)</option>
              </select>
            </div>

            <!-- PILAR 1: ANKLE -->
            <div class="col-6"><label class="gold">Ankle Kiri (cm)</label><input type="number" name="ankle_kiri_cm" id="ankle_kiri" class="form-control" step="0.5" min="0" oninput="calcAnkle(); liveUpdate();"></div>
            <div class="col-6"><label class="gold">Ankle Kanan (cm)</label><input type="number" name="ankle_kanan_cm" id="ankle_kanan" class="form-control" step="0.5" min="0" oninput="calcAnkle(); liveUpdate();"></div>
            <div class="col-12 auto-score-row"><span class="auto-score-label">Skor Ankle Mobility (otomatis)</span><span class="auto-score-badge" id="badge_ankle">—</span><input type="hidden" name="score_ankle" id="score_ankle"></div>
            <div class="col-12 penalti-flag" id="flag_ankle" style="display:none">⚠️ Asimetri &gt; 2 cm — skor Ankle otomatis dikurangi 1 poin</div>

            <!-- PILAR 2: HIP -->
            <div class="col-6"><label class="cyan">Hip Flexion Kiri (°)</label><input type="number" name="hip_fleksi_kiri" id="hip_kiri" class="form-control" step="1" min="0" oninput="calcHip(); liveUpdate();"></div>
            <div class="col-6"><label class="cyan">Hip Flexion Kanan (°)</label><input type="number" name="hip_fleksi_kanan" id="hip_kanan" class="form-control" step="1" min="0" oninput="calcHip(); liveUpdate();"></div>
            <div class="col-12 auto-score-row"><span class="auto-score-label">Skor Hip Mobility (otomatis)</span><span class="auto-score-badge" id="badge_hip">—</span><input type="hidden" name="score_hip" id="score_hip"></div>
            <div class="col-12 penalti-flag" id="flag_hip" style="display:none">⚠️ Asimetri &gt; 10° — skor Hip otomatis dikurangi 1 poin</div>

            <!-- PILAR 3: SHOULDER -->
            <div class="col-12"><label class="cyan">Shoulder Flexion — lengan tembak, terbaik (°)</label><input type="number" name="shoulder_fleksi" id="shoulder" class="form-control" step="1" min="0" oninput="calcShoulder(); liveUpdate();"></div>
            <div class="col-12 auto-score-row"><span class="auto-score-label">Skor Shoulder Mobility (otomatis)</span><span class="auto-score-badge" id="badge_shoulder">—</span><input type="hidden" name="score_shoulder" id="score_shoulder"></div>

            <!-- PILAR 4: STABILITY -->
            <div class="col-6"><label class="cyan">Balance Kiri (dtk)</label><input type="number" name="balance_kiri_detik" id="balance_kiri" class="form-control" step="0.5" min="0" oninput="calcStability(); liveUpdate();"></div>
            <div class="col-6"><label class="cyan">Balance Kanan (dtk)</label><input type="number" name="balance_kanan_detik" id="balance_kanan" class="form-control" step="0.5" min="0" oninput="calcStability(); liveUpdate();"></div>
            <div class="col-12 auto-score-row"><span class="auto-score-label">Skor Stability (otomatis)</span><span class="auto-score-badge" id="badge_stability">—</span><input type="hidden" name="score_stability" id="score_stability"></div>

            <!-- PILAR 5: POSTURE (kualitatif) -->
            <div class="col-12">
              <label class="cyan">Posture Screening — Plumb Line</label>
              <select id="sel_posture" class="form-control" onchange="calcPosture(); liveUpdate();">
                <option value="">— Pilih kondisi hasil observasi —</option>
                <option value="9">Baik/Ideal (8–10) — alignment netral, kepala/bahu/panggul simetris</option>
                <option value="6">Cukup (5–7) — deviasi ringan pada 1 segmen (mis. forward head ringan)</option>
                <option value="3">Kurang (1–4) — deviasi berat (forward head parah, hyper-kyphosis, bahu miring)</option>
              </select>
            </div>
            <div class="col-12 auto-score-row"><span class="auto-score-label">Skor Posture</span><span class="auto-score-badge" id="badge_posture">—</span><input type="hidden" name="score_posture" id="score_posture"></div>

            <div class="col-12"><label>Catatan Coach</label><textarea name="catatan" class="form-control" rows="2" placeholder="Kompensasi saat landing, sisi dominan, keluhan nyeri..."></textarea></div>
          </div>
        </div>
      </div>

      <!-- Kolom 2: Radar + Profil -->
      <div class="col-lg-4">
        <div class="card-x text-center">
          <div class="card-title"><i class="bi bi-radar"></i> Mobility Radar</div>
          <div style="height:300px;display:flex;align-items:center;justify-content:center"><canvas id="radarChart"></canvas></div>
          <div id="narasi_panel" class="mt-3 text-start" style="display:none">
            <div class="card-title"><i class="bi bi-person-lines-fill" style="color:var(--cyan)"></i> Profil Kondisi Atlet</div>
            <div id="narasi_box" class="narasi-box"></div>
          </div>
        </div>
      </div>

      <!-- Kolom 3: Hasil + Rekomendasi -->
      <div class="col-lg-4">
        <div class="card-x text-center">
          <div class="card-title"><i class="bi bi-trophy-fill"></i> Audit Result</div>
          <div class="py-2">
            <div class="score-big" id="res_total">0.0</div>
            <div class="mt-2"><span class="predikat-pill pred-NOVICE" id="res_predikat">NOVICE</span></div>
            <div class="mono mt-2" style="font-size:10px;color:var(--text3)" id="res_layak">Isi data untuk melihat hasil audit</div>
          </div>
          <button type="submit" class="btn w-100 fw-bold mt-2 btn-save"><i class="bi bi-save2-fill me-1"></i>SAVE AUDIT</button>
          <div id="reko_panel" class="mt-3 text-start" style="display:none">
            <div class="card-title"><i class="bi bi-lightbulb-fill" style="color:var(--gold)"></i> Rekomendasi HPCS</div>
            <div id="reko_list"></div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- TABEL HISTORY -->
  <div class="no-print">
    <div class="card-x">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="card-title mb-0"><i class="bi bi-database-fill"></i> Database &amp; History Audit</div>
        <div class="filter-bar mb-0">
          <a href="?category=" class="ftab {% if not selected_category %}ftab-all{% endif %}">Semua</a>
          <a href="?category=elite" class="ftab {% if selected_category == 'elite' %}ftab-elite{% endif %}">Elite</a>
          <a href="?category=youth" class="ftab {% if selected_category == 'youth' %}ftab-youth{% endif %}">Youth</a>
          <a href="?category=junior" class="ftab {% if selected_category == 'junior' %}ftab-junior{% endif %}">Junior</a>
          <a href="?category=senior" class="ftab {% if selected_category == 'senior' %}ftab-senior{% endif %}">Senior</a>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
          <thead><tr><th>Tanggal</th><th>Atlet</th><th>Kategori</th><th>Total Skor</th><th>Predikat</th><th>Ankle</th><th>Hip</th><th>Shoulder</th><th>Stability</th><th>Posture</th><th class="text-center">Aksi</th></tr></thead>
          <tbody>
          {% for audit in history %}
          <tr id="row-{{ audit.id }}">
            <td class="mono x-small" style="color:var(--text3)">{{ audit.timestamp|date:"d/m/Y H:i" }}</td>
            <td class="fw-bold">{{ audit.atlet.nama_atlet }}</td>
            <td><span class="mono x-small" style="color:var(--cyan)">{{ audit.kategori_usia }}</span></td>
            <td><span class="bebas" style="font-size:1.2rem;color:var(--cyan)">{{ audit.total_skor }}</span></td>
            <td><span class="badge rounded-pill {% if audit.predikat == 'ELITE' %}bg-success{% elif audit.predikat == 'READY' %}bg-info text-dark{% elif audit.predikat == 'DEVELOPING' %}bg-warning text-dark{% else %}bg-danger{% endif %}">{{ audit.predikat }}</span></td>
            <td class="mono x-small" style="color:var(--text2)">{{ audit.score_ankle|floatformat:1 }}</td>
            <td class="mono x-small" style="color:var(--text2)">{{ audit.score_hip|floatformat:1 }}</td>
            <td class="mono x-small" style="color:var(--text2)">{{ audit.score_shoulder|floatformat:1 }}</td>
            <td class="mono x-small" style="color:var(--text2)">{{ audit.score_stability|floatformat:1 }}</td>
            <td class="mono x-small" style="color:var(--text2)">{{ audit.score_posture|floatformat:1 }}</td>
            <td class="text-center">
              <button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 me-1" title="Cetak PDF"
                onclick="cetakAuditBasket({{ audit.id }},'{{ audit.atlet.nama_atlet|escapejs }}','{{ audit.kategori_usia }}','{{ audit.gender }}',{{ audit.score_ankle|stringformat:'f' }},{{ audit.score_hip|stringformat:'f' }},{{ audit.score_shoulder|stringformat:'f' }},{{ audit.score_stability|stringformat:'f' }},{{ audit.score_posture|stringformat:'f' }},{{ audit.total_skor|stringformat:'f' }},'{{ audit.predikat }}','{{ audit.timestamp|date:"d/m/Y H:i" }}')"><i class="bi bi-printer-fill"></i></button>
              <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 ms-1" title="Kirim WhatsApp"
                onclick="kirimWARowL1('{{ audit.atlet.nama_atlet|escapejs }}','{{ audit.kategori_usia }}',{{ audit.total_skor|stringformat:'f' }},'{{ audit.predikat }}','{{ audit.timestamp|date:"d/m/Y H:i" }}','{{ audit.atlet.pelatih.profil_pelatih.no_hp|default:""|escapejs }}')"><i class="bi bi-whatsapp"></i></button>
              <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" title="Hapus" onclick="konfirmasiHapus({{ audit.id }}, '{{ audit.atlet.nama_atlet|escapejs }}')"><i class="bi bi-trash3-fill"></i></button>
            </td>
          </tr>
          {% empty %}
          <tr><td colspan="11" class="text-center py-5" style="color:var(--text3)"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Belum ada data. Simpan audit pertama Anda.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% if history %}<div class="text-end mono x-small" style="color:var(--text3)">Menampilkan {{ history|length }} record{% if selected_category %} &middot; filter: {{ selected_category|title }}{% endif %}</div>{% endif %}
    </div>
  </div>
</div>

<!-- MODAL HAPUS -->
<div class="modal fade" id="modalHapus" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content" style="border-color:rgba(231,76,60,0.4)"><div class="modal-body p-4">
    <div class="d-flex gap-3 align-items-start"><i class="bi bi-exclamation-triangle-fill text-danger fs-4 mt-1"></i>
      <div><div class="fw-bold mb-1">Hapus Data Audit?</div>
      <div class="small" style="color:var(--text2)">Data audit <strong id="modal_nama_atlet" class="text-white"></strong> akan dihapus permanen.<br><span class="text-danger">Tindakan ini tidak dapat dibatalkan.</span></div></div></div>
    <div class="d-flex gap-2 justify-content-end mt-3">
      <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Batal</button>
      <button type="button" class="btn btn-sm btn-danger fw-bold" id="btn_hapus_confirm"><i class="bi bi-trash3-fill me-1"></i>Ya, Hapus</button>
    </div></div></div></div>
</div>

{{ rubrik_l1|json_script:"rubrik-l1-data" }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const HAPUS_URL = "{% url 'basketball:hapus_l1' 0 %}";
const RUB = JSON.parse(document.getElementById('rubrik-l1-data').textContent);
const KAT_BUCKET = {YOUTH:'10', JUNIOR:'15', SENIOR:'25', ELITE:'25'};
const NAMA_PILAR = {ankle:'Ankle Mobility', hip:'Hip Mobility', shoulder:'Shoulder Mobility', stability:'Stability', posture:'Posture'};
const ASIM = {ankle:[2,1], hip:[10,1]};

function onAtletChange(sel) {
  const opt = sel.options[sel.selectedIndex];
  if (!opt || !opt.value) return;
  const setVal = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
  const kategori = (opt.dataset.kategori || '').toUpperCase(), umur = parseInt(opt.dataset.umur, 10);
  setVal('id_atlet_hidden', opt.value); setVal('atlet_name_hidden', opt.dataset.nama || '');
  setVal('kelas_berat_hidden', opt.dataset.berat || ''); setVal('kategori_usia_hidden', kategori || 'ELITE');
  setVal('gender_hidden', opt.dataset.gender === 'Putri' ? 'Putri' : 'Putra'); setVal('posisi_hidden', opt.dataset.posisi || '');
  let bucket = KAT_BUCKET[kategori] || '25';
  if (!isNaN(umur)) bucket = umur <= 8 ? '7' : umur <= 11 ? '10' : umur <= 17 ? '15' : '25';
  setVal('usia_kat_sop', bucket);
  recalcAll();
}

function interpolasiSkor(nilai, bawah, atas) {
  if (nilai === null || isNaN(nilai) || nilai <= 0) return null;
  if (nilai < bawah) return Math.min(1 + 3 * (nilai / bawah), 4.0);
  if (nilai <= atas) { const p = (atas > bawah) ? (nilai - bawah) / (atas - bawah) : 1; return 5 + 2 * p; }
  const rentang = atas > 0 ? atas * 0.5 : 1, p2 = Math.min((nilai - atas) / rentang, 1.0);
  return Math.min(8 + 2 * p2, 10.0);
}
function usiaKat() { return document.getElementById('usia_kat_sop').value || '25'; }
function genderSop() { return document.getElementById('gender_hidden').value === 'Putri' ? 'Putri' : 'Putra'; }
function norma(pilar) { return RUB[pilar][usiaKat() + '_' + genderSop()]; }
function nilaiOf(id) { const v = parseFloat(document.getElementById(id).value); return (isNaN(v) || v <= 0) ? null : v; }
function setBadgeSkor(badgeId, hiddenId, skor) {
  const badge = document.getElementById(badgeId), hidden = document.getElementById(hiddenId);
  if (skor === null) { badge.textContent = '—'; badge.className = 'auto-score-badge'; hidden.value = ''; return; }
  skor = Math.round(skor * 10) / 10;
  badge.textContent = skor.toFixed(1);
  badge.className = 'auto-score-badge ' + (skor >= 8 ? 'as-elite' : skor >= 5 ? 'as-ready' : 'as-novice');
  hidden.value = skor;
}
function skorSisiTerlemah(idKiri, idKanan, pilar) {
  const v = [nilaiOf(idKiri), nilaiOf(idKanan)].filter(x => x !== null);
  if (!v.length) return {s: null, pen: false};
  const n = norma(pilar); let s = interpolasiSkor(Math.min(...v), n[0], n[1]), pen = false;
  const [lim, p] = ASIM[pilar];
  if (v.length === 2 && Math.abs(v[0] - v[1]) > lim) { s = Math.max(1.0, s - p); pen = true; }
  return {s, pen};
}
function calcAnkle() { const r = skorSisiTerlemah('ankle_kiri', 'ankle_kanan', 'ankle'); setBadgeSkor('badge_ankle', 'score_ankle', r.s); document.getElementById('flag_ankle').style.display = r.pen ? 'block' : 'none'; }
function calcHip() { const r = skorSisiTerlemah('hip_kiri', 'hip_kanan', 'hip'); setBadgeSkor('badge_hip', 'score_hip', r.s); document.getElementById('flag_hip').style.display = r.pen ? 'block' : 'none'; }
function calcShoulder() { const v = nilaiOf('shoulder'), n = norma('shoulder'); setBadgeSkor('badge_shoulder', 'score_shoulder', v === null ? null : interpolasiSkor(v, n[0], n[1])); }
function calcStability() {
  const n = norma('stability');
  const s = [nilaiOf('balance_kiri'), nilaiOf('balance_kanan')].map(v => interpolasiSkor(v, n[0], n[1])).filter(x => x !== null);
  setBadgeSkor('badge_stability', 'score_stability', s.length ? s.reduce((a, b) => a + b, 0) / s.length : null);
}
function calcPosture() { const v = document.getElementById('sel_posture').value; setBadgeSkor('badge_posture', 'score_posture', v ? parseFloat(v) : null); }
function recalcAll() { calcAnkle(); calcHip(); calcShoulder(); calcStability(); calcPosture(); liveUpdate(); }
function g(id) { return parseFloat(document.getElementById(id).value) || 0; }

let radarInst = null;
function updateRadar(vals) {
  const ctx = document.getElementById('radarChart').getContext('2d');
  if (radarInst) radarInst.destroy();
  radarInst = new Chart(ctx, {type: 'radar', data: {labels: ['Ankle', 'Hip', 'Shoulder', 'Stability', 'Posture'],
    datasets: [{label: 'Atlet', data: vals, fill: true, backgroundColor: 'rgba(249,115,22,0.12)', borderColor: '#f97316', borderWidth: 2, pointBackgroundColor: '#f97316', pointRadius: 4}]},
    options: {responsive: true, maintainAspectRatio: false, plugins: {legend: {display: false}},
      scales: {r: {min: 0, max: 10, ticks: {display: false, stepSize: 2}, grid: {color: 'rgba(255,255,255,0.07)'}, angleLines: {color: 'rgba(255,255,255,0.07)'}, pointLabels: {color: '#8892a8', font: {size: 11}}}}}});
}
function liveUpdate() {
  const sc = {ankle: g('score_ankle'), hip: g('score_hip'), shoulder: g('score_shoulder'), stability: g('score_stability'), posture: g('score_posture')};
  const filled = Object.values(sc).filter(s => s > 0);
  const total = filled.length ? Math.floor(filled.reduce((a, b) => a + b, 0) / filled.length * 10 + 0.5) / 10 : 0;
  document.getElementById('res_total').textContent = total.toFixed(1);
  let pred, col;
  if (total >= 9.0) { pred = 'ELITE'; col = 'var(--green)'; } else if (total >= 7.0) { pred = 'READY'; col = 'var(--cyan)'; }
  else if (total >= 5.0) { pred = 'DEVELOPING'; col = 'var(--gold)'; } else { pred = 'NOVICE'; col = 'var(--red)'; }
  const predEl = document.getElementById('res_predikat'); predEl.textContent = pred; predEl.className = 'predikat-pill pred-' + pred;
  document.getElementById('res_total').style.color = col;
  const ly = document.getElementById('res_layak');
  if (!filled.length) { ly.textContent = 'Isi data untuk melihat hasil audit'; ly.style.color = 'var(--text3)'; }
  else if (total >= 7.0) { ly.textContent = '✅ LAYAK naik ke L2 — Strength'; ly.style.color = 'var(--green)'; }
  else { ly.textContent = '⚠️ Skor ' + total.toFixed(1) + ' < 7.0 — belum layak ke L2, jalankan program korektif'; ly.style.color = 'var(--gold)'; }
  updateRadar([sc.ankle, sc.hip, sc.shoulder, sc.stability, sc.posture]);
  const pilars = Object.keys(sc).map(k => ({key: k, nama: NAMA_PILAR[k], val: sc[k]}));
  generateReko(pilars); generateNarasi(pilars, total, pred);
}

function generateNarasi(pilars, total, pred) {
  const panel = document.getElementById('narasi_panel'), box = document.getElementById('narasi_box');
  const filled = pilars.filter(p => p.val > 0);
  if (!filled.length) { panel.style.display = 'none'; return; }
  const sel = document.getElementById('select-atlet'), namaAtlet = (sel && sel.value) ? sel.options[sel.selectedIndex].textContent.trim() : 'Atlet';
  const lbl = v => v >= 9 ? 'sangat baik' : v >= 7.5 ? 'baik' : v >= 5.5 ? 'cukup' : 'perlu perhatian khusus';
  const wrn = v => v >= 9 ? 'var(--green)' : v >= 7.5 ? 'var(--cyan)' : v >= 5.5 ? 'var(--gold)' : 'var(--red)';
  const sorted = [...filled].sort((a, b) => b.val - a.val), kuat = sorted.slice(0, 2), lemah = sorted.slice(-2).reverse(), layak = total >= 7.0;
  const kPred = {
    ELITE: 'menunjukkan kapasitas mobilitas <strong style="color:var(--green)">ELIT</strong> — seluruh pilar di level puncak.',
    READY: 'berada di level <strong style="color:var(--cyan)">SIAP (READY)</strong> — fondasi gerak solid dengan beberapa area yang bisa ditingkatkan.',
    DEVELOPING: 'sedang <strong style="color:var(--gold)">BERKEMBANG</strong> — fondasi mulai terbentuk namun pilar kritis perlu koreksi.',
    NOVICE: 'berada di level <strong style="color:var(--red)">PEMULA (NOVICE)</strong> — perlu membangun mobilitas dasar sebelum program beban.'};
  const dot = c => '<div style="width:6px;height:6px;border-radius:50%;background:' + c + ';flex-shrink:0"></div>';
  const kuatHTML = kuat.map(p => '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">' + dot('var(--green)') + '<span><strong style="color:var(--green)">' + p.nama + '</strong> — ' + lbl(p.val) + ' <span style="color:' + wrn(p.val) + ';font-weight:700">(' + p.val.toFixed(1) + '/10)</span>' + (p.val >= 9 ? ' : pilar unggulan, pertahankan.' : p.val >= 7.5 ? ' : aset gerak di lapangan.' : ' : perkembangan positif.') + '</span></div>').join('');
  const minV = Math.min(...filled.map(p => p.val)), maxV = Math.max(...filled.map(p => p.val)), semuaPrima = (maxV - minV) <= 0.5 && minV >= 8.5;
  const lemahHTML = semuaPrima ? '<div style="padding:8px 10px;background:rgba(46,204,113,0.07);border-radius:6px;border:1px solid rgba(46,204,113,0.2);color:var(--green);font-weight:600">🏆 Semua pilar dalam kondisi prima — tidak ada kelemahan signifikan.</div>'
    : lemah.map(p => '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">' + dot(wrn(p.val)) + '<span><strong style="color:' + wrn(p.val) + '">' + p.nama + '</strong> — ' + lbl(p.val) + ' <span style="color:' + wrn(p.val) + ';font-weight:700">(' + p.val.toFixed(1) + '/10)</span>' + (p.val < 5.5 ? ' : prioritas utama program korektif.' : p.val < 7.5 ? ' : perlu perhatian dalam program latihan.' : ' : jaga konsistensi.') + '</span></div>').join('');
  const fokus = semuaPrima ? 'Pertahankan performa. Atlet siap masuk L2 Strength dengan beban penuh.'
    : layak ? 'Fondasi gerak cukup kuat. Fokus perkuat <strong>' + (lemah[0] ? lemah[0].nama : '-') + '</strong> selama L2.'
    : 'Jalankan korektif 4–6 minggu, fokus <strong>' + (lemah[0] ? lemah[0].nama : '-') + '</strong>' + (lemah[1] ? ' dan <strong>' + lemah[1].nama + '</strong>' : '') + '.';
  box.innerHTML = '<div style="margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid rgba(249,115,22,0.15)"><span style="color:var(--cyan);font-weight:700;font-size:12px">👤 ' + namaAtlet + '</span> ' + (kPred[pred] || '') + ' Total skor: <strong style="font-size:13px;color:' + wrn(total) + '">' + total.toFixed(1) + '/10</strong></div>'
    + '<div style="margin-bottom:10px"><div style="color:var(--text3);font-size:10px;margin-bottom:5px;letter-spacing:1px">▲ KEUNGGULAN</div>' + kuatHTML + '</div>'
    + '<div style="margin-bottom:10px"><div style="color:var(--text3);font-size:10px;margin-bottom:5px;letter-spacing:1px">▼ AREA KELEMAHAN</div>' + lemahHTML + '</div>'
    + '<div style="padding:10px 12px;border-radius:8px;background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.07)"><div style="color:var(--text3);font-size:10px;margin-bottom:6px;letter-spacing:1px">📋 KESIMPULAN</div>'
    + (layak ? '<span style="color:var(--green);font-weight:700">✅ LAYAK mengikuti program Latihan Kekuatan (L2 Strength)</span>' : '<span style="color:var(--red);font-weight:700">⛔ BELUM LAYAK ke L2 — perlu program korektif terlebih dahulu</span>')
    + '<br><span style="color:var(--text2);font-size:10.5px">' + fokus + '</span></div>';
  panel.style.display = 'block';
}

const REKO_DB = {
  Ankle: {
    low: ['Weighted-bearing lunge drill 3x10 reps setiap hari','Calf raise eccentric di tangga','Foam roll gastrocnemius + soleus 5 menit/sisi'],
    mid: ['Lunge depth progression drill','Single-leg squat dengan ankle focus','Band-assisted dorsiflexion mobilization'],
    high: ['Pertahankan ankle mobility dengan dynamic warm-up','Variasi plyometric landing: soft & stiff ankle']
  },
  Hip: {
    low: ['90-90 hip stretch 3x60 detik/sisi','Hip flexor lunge stretch 3x45 detik','Supine hip flexion CARs (Controlled Articular Rotations)'],
    mid: ['Deep squat hold progression','Single-leg hip hinge 3x10','Hip flow sequence sebelum latihan'],
    high: ['Pertahankan dengan lateral lunge variasi','Rotational hip warm-up sebelum game']
  },
  Shoulder: {
    low: ['Wall angel 3x10 reps slow','Doorway chest stretch 3x45 detik','Band pull-apart 3x15 reps'],
    mid: ['Overhead mobility progression dengan dowel','Sleeper stretch untuk posterior capsule','Face pull 3x15 reps untuk rotator cuff'],
    high: ['Shooting-specific shoulder warm-up','Rotator cuff strengthening 2x/minggu']
  },
  Stability: {
    low: ['Single-leg stance progression: mata terbuka → tertutup','Wobble board training 3x30 detik','Pertahankan dengan mini band lateral walk'],
    mid: ['Single-leg Romanian deadlift 3x8','Balance board squat progression','Y-Balance Test drill'],
    high: ['Reactive stability: single-leg catch & release','Plyometric landing mechanics: bilateral → unilateral']
  },
  Postur: {
    low: ['Chin tuck exercise 3x10 reps','Thoracic extension over foam roller','Scapular retraction & depression 3x15'],
    mid: ['Wall posture check & correction drill','Band row untuk scapular stabilizer','Core bracing & postur awareness'],
    high: ['Pertahankan dengan mobility routine pagi hari','Video feedback saat shooting untuk postur awareness']
  }
};
const REKO_KEY = {ankle:'Ankle', hip:'Hip', shoulder:'Shoulder', stability:'Stability', posture:'Postur'};
function generateReko(pilars) {
  const panel = document.getElementById('reko_panel'), list = document.getElementById('reko_list');
  const filled = pilars.filter(p => p.val > 0);
  if (!filled.length) { panel.style.display = 'none'; return; }
  let html = '';
  [...filled].sort((a, b) => a.val - b.val).slice(0, 3).forEach(p => {
    const db = REKO_DB[REKO_KEY[p.key]]; if (!db) return;
    const tips = p.val < 5.5 ? db.low : p.val < 7.5 ? db.mid : db.high, icon = p.val < 5.5 ? '🔴' : p.val < 7.5 ? '🟡' : '🟢';
    html += '<div style="margin-bottom:8px"><div class="x-small mono mb-1" style="color:var(--cyan)">' + icon + ' ' + p.nama.toUpperCase() + ' — ' + p.val.toFixed(1) + '/10</div>'
      + tips.map(t => '<div class="reko-item"><span class="reko-icon">→</span><span>' + t + '</span></div>').join('') + '</div>';
  });
  list.innerHTML = html; panel.style.display = 'block';
}

// ── Rubrik: tabel dirender dari JSON server ──────────────────────────
const BUCKET_LBL = {'7':'Anak-Anak (6–8 thn)', '10':'Anak-Anak (9–11 thn)', '15':'Remaja (12–17 thn)', '25':'Dewasa (18–35 thn)'};
const TABEL_META = [['ankle', 'A. Ankle Mobility', 'Weight-Bearing Lunge Test — cm', 'cm'], ['stability', 'B. Stability', 'Single Leg Stance, mata tertutup — detik', 'det'],
  ['hip', 'C. Hip Mobility', 'Hip Flexion ROM — derajat°', '°'], ['shoulder', 'D. Shoulder Mobility', 'Shoulder Flexion ROM — derajat°', '°']];
function renderRubrik() {
  let h = '';
  TABEL_META.forEach(([k, judul, sub, u]) => {
    h += '<b style="font-size:10.5px;color:var(--text)">' + judul + ' <span style="color:var(--text3);font-weight:400">(' + sub + ')</span></b><table><thead><tr><th>Kategori Usia</th><th>Gender</th><th>Kurang (1–4)</th><th>Cukup (5–7)</th><th>Baik/Ideal (8–10)</th></tr></thead><tbody>';
    ['7', '10', '15', '25'].forEach(b => {
      const pa = RUB[k][b + '_Putra'], pi = RUB[k][b + '_Putri'], sama = pa[0] === pi[0] && pa[1] === pi[1];
      const rows = sama ? [['Putra/Putri', pa]] : [['Laki-laki', pa], ['Perempuan', pi]];
      rows.forEach(r => { const [x, y] = r[1];
        h += '<tr><td>' + BUCKET_LBL[b] + '</td><td>' + r[0] + '</td><td class="kurang">&lt; ' + x + ' ' + u + '</td><td class="cukup">' + x + ' – ' + y + ' ' + u + '</td><td class="baik">&gt; ' + y + ' ' + u + '</td></tr>'; });
    });
    h += '</tbody></table>';
  });
  document.getElementById('rubrikTables').innerHTML = h;
}
function toggleRubrik() {
  const p = document.getElementById('rubrikPanel'), c = document.getElementById('rubrik-chevron'), open = p.style.display === 'none';
  p.style.display = open ? 'block' : 'none'; c.className = open ? 'bi bi-chevron-up' : 'bi bi-chevron-down'; if (open) renderRubrik();
}

// ── Hapus (POST + modal, seperti Boxing) ─────────────────────────────
function getCsrf() { return document.cookie.split(';').find(c => c.trim().startsWith('csrftoken='))?.split('=')[1] ?? ''; }
function konfirmasiHapus(auditId, namaAtlet) {
  document.getElementById('modal_nama_atlet').textContent = namaAtlet;
  const b = document.getElementById('btn_hapus_confirm'), baru = b.cloneNode(true); b.parentNode.replaceChild(baru, b);
  baru.addEventListener('click', () => eksekusiHapus(auditId, namaAtlet));
  new bootstrap.Modal(document.getElementById('modalHapus')).show();
}
function eksekusiHapus(auditId, namaAtlet) {
  fetch(HAPUS_URL.replace(/0(\/?)$/, auditId + '$1'), {method: 'POST', headers: {'X-CSRFToken': getCsrf(), 'X-Requested-With': 'XMLHttpRequest'}})
    .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json().catch(() => ({status: 'success'})); })
    .then(() => { bootstrap.Modal.getInstance(document.getElementById('modalHapus'))?.hide(); const row = document.getElementById('row-' + auditId);
      if (row) { row.style.transition = 'opacity .35s,transform .35s'; row.style.opacity = '0'; row.style.transform = 'translateX(-12px)'; setTimeout(() => row.remove(), 380); }
      showToast('Data ' + namaAtlet + ' berhasil dihapus.', 'success'); })
    .catch(e => showToast('Gagal: ' + e.message, 'danger'));
}
function showToast(msg, type) { const el = document.createElement('div'); el.className = 'toast-hpcs'; el.style.background = type === 'success' ? '#20c997' : '#e74c3c'; el.style.color = '#000'; el.textContent = msg; document.body.appendChild(el); setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 400); }, 2800); }

// ── WhatsApp per baris (pola Boxing: no HP coach dari profil pelatih) ──
function kirimWARowL1(nama, kat, total, predikat, tgl, noHpCoach) {
  let waNum = (noHpCoach || '').replace(/[^0-9]/g, '');
  if (waNum.startsWith('0')) waNum = '62' + waNum.slice(1); else if (!waNum.startsWith('62') && waNum.length > 0) waNum = '62' + waNum;
  const pesan = encodeURIComponent('*LAPORAN AUDIT L1 - HPCS BASKETBALL*\n========================\nAtlet: ' + nama + '\nKategori: ' + kat + '\nTanggal: ' + tgl + '\n========================\nTotal Skor: ' + parseFloat(total).toFixed(1) + '/10\nPredikat: ' + predikat + '\n========================\nDikirim otomatis oleh HPCS Basketball System');
  if (waNum.length > 8) { window.open('https://wa.me/' + waNum + '?text=' + pesan, '_blank'); return; }
  const n = prompt('Nomor WhatsApp tujuan (contoh: 08123456789):'); if (!n) return;
  let num = n.replace(/[^0-9]/g, ''); if (num.startsWith('0')) num = '62' + num.slice(1);
  window.open('https://wa.me/' + num + '?text=' + pesan, '_blank');
}

function cetakAuditBasket(id,nama,kat,gender,ankle,hip,shoulder,stability,postur,total,predikat,tgl){
  const warna={ELITE:'#10b981',READY:'#f97316',DEVELOPING:'#facc15',NOVICE:'#ef4444'}[predikat]||'#6b7280';
  const pilar=[
    {n:'Ankle Mobility',v:parseFloat(ankle)||0,icon:'🦶'},
    {n:'Hip Mobility',v:parseFloat(hip)||0,icon:'🔄'},
    {n:'Shoulder Mob.',v:parseFloat(shoulder)||0,icon:'💪'},
    {n:'Stability',v:parseFloat(stability)||0,icon:'⚖️'},
    {n:'Postur',v:parseFloat(postur)||0,icon:'🧍'},
  ];
  const pilarHTML=pilar.map(p=>{
    const pct=Math.min(100,(p.v/10)*100).toFixed(0);
    const c=p.v>=8?'#10b981':p.v>=6?'#f97316':p.v>=4?'#facc15':'#ef4444';
    return `<div style="flex:1;min-width:80px;text-align:center;background:#f8fafc;border:1.5px solid ${c};border-radius:10px;padding:10px 6px">
      <div style="font-size:16px">${p.icon}</div>
      <div style="font-size:9px;color:#555;text-transform:uppercase;letter-spacing:1px">${p.n}</div>
      <div style="font-size:24px;font-weight:900;color:${c}">${p.v.toFixed(1)}</div>
      <div style="height:4px;background:#e5e7eb;border-radius:2px;margin-top:4px;overflow:hidden">
      <div style="height:100%;width:${pct}%;background:${c};border-radius:2px"></div></div></div>`;
  }).join('');
  const terlemah = pilar.filter(p=>p.v>0).sort((a,b)=>a.v-b.v)[0];
  const terkuat = pilar.filter(p=>p.v>0).sort((a,b)=>b.v-a.v)[0];
  const pct=Math.min(100,(parseFloat(total)/10)*100).toFixed(0);
  const html=`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>L1 Basketball - ${nama}</title>
  <style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Segoe UI',sans-serif;background:#fff;color:#111;font-size:13px}@media print{@page{margin:15mm 12mm;size:A4}}</style>
  </head><body>
  <div style="background:linear-gradient(135deg,#0f172a,#1a0a00);color:#fff;padding:20px 28px;display:flex;justify-content:space-between;align-items:center">
    <div><div style="font-size:9px;letter-spacing:3px;color:#94a3b8;text-transform:uppercase">HIGH PERFORMANCE BASKETBALL SYSTEM</div>
    <div style="font-size:22px;font-weight:900;letter-spacing:2px">HPCS <span style="color:#f97316">BASKETBALL</span></div>
    <div style="font-size:11px;color:#cbd5e1">Audit Level 1 — Core & Mobility</div></div>
    <div style="background:${warna};color:#fff;padding:6px 16px;border-radius:20px;font-size:13px;font-weight:800">${predikat}</div>
  </div>
  <div style="padding:14px 28px;background:#f8fafc;border-bottom:1px solid #e2e8f0">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
    ${[['Nama Atlet',nama],['Kategori',kat],['Gender',gender],['Tanggal',tgl],['Cabang','Basketball 🏀'],['Level','L1 — Core & Mobility']].map(([l,v])=>
      `<div style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:10px 14px">
      <div style="font-size:9px;color:#94a3b8;text-transform:uppercase">${l}</div>
      <div style="font-size:15px;font-weight:700;color:#0f172a;margin-top:2px">${v}</div></div>`).join('')}
    </div>
  </div>
  <div style="padding:14px 28px;display:flex;align-items:center;gap:20px;background:#fff7ed;border-bottom:2px solid ${warna}">
    <div style="text-align:center;min-width:90px">
      <div style="font-size:9px;color:#555;text-transform:uppercase">Total Skor</div>
      <div style="font-size:52px;font-weight:900;color:${warna}">${parseFloat(total).toFixed(1)}</div>
    </div>
    <div style="flex:1">
      <div style="height:10px;background:#e5e7eb;border-radius:5px;overflow:hidden">
      <div style="height:100%;width:${pct}%;background:${warna};border-radius:5px"></div></div>
      <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
        ${terkuat?`<div style="background:#fff;border:1px solid #e2e8f0;border-radius:6px;padding:5px 10px;font-size:10px"><span style="color:#888">Terkuat:</span> <strong style="color:#10b981">${terkuat.n} (${terkuat.v.toFixed(1)})</strong></div>`:''}
        ${terlemah&&terlemah!==terkuat?`<div style="background:#fff;border:1px solid #e2e8f0;border-radius:6px;padding:5px 10px;font-size:10px"><span style="color:#888">Prioritas:</span> <strong style="color:#ef4444">${terlemah.n} (${terlemah.v.toFixed(1)})</strong></div>`:''}
      </div>
    </div>
  </div>
  <div style="padding:14px 28px"><div style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#64748b;margin-bottom:10px">Skor Pilar Analysis</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">${pilarHTML}</div></div>
  <div style="background:#0f172a;color:#94a3b8;padding:10px 28px;display:flex;justify-content:space-between;font-size:10px;margin-top:8px">
    <div>HPCS Basketball — High Performance Basketball System</div><div>${tgl}</div>
  </div>
  <div style="padding:14px 28px;display:flex;justify-content:flex-end">
    <div style="text-align:center;min-width:180px"><div style="border-top:1px solid #374151;padding-top:6px;margin-top:40px;font-size:10px;color:#555">Coach / Pelatih<br><span style="font-size:9px;color:#94a3b8">(__________________________)</span></div></div>
  </div>
  </body></html>`;
  const win=window.open('','_blank','width=960,height=800');
  if(!win){alert('Izinkan pop-up.');return;}
  win.document.write(html);win.document.close();win.focus();
  win.onload=()=>{setTimeout(()=>{win.print();win.onafterprint=()=>win.close();},600);};
}

updateRadar([0, 0, 0, 0, 0]);
document.addEventListener('DOMContentLoaded', function () { const sel = document.getElementById('select-atlet'); if (sel && sel.value) onAtletChange(sel); });
</script>
{% endblock %}